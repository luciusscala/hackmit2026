# Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Elasticsearch — 3D map only (server-side; never NEXT_PUBLIC_ this key).
# Same values as ../map-pipeline/.env. Leave unset to serve the map from the
# committed public/map/coords.json snapshot instead.
ELASTIC_URL=https://YOUR-DEPLOYMENT.es.us-east-1.aws.elastic.cloud:443
ELASTIC_API_KEY=your-elastic-api-key
ELASTIC_INDEX=hackmit-map

# "Pull live" button on the map pages spawns ../map-pipeline/refresh.py.
# BACKEND_DIR=/absolute/path/to/map-pipeline
# BACKEND_PYTHON=/absolute/path/to/map-pipeline/.venv/bin/python
# REFRESH_SECRET=optional-shared-secret   (required in production)
